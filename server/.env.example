PORT=5000
MONGO_URI=mongodb://localhost:27017/baafiye
JWT_SECRET=replace_with_a_long_random_secret

# Public URL of the React client (used in password-reset emails)
CLIENT_URL=http://localhost:3000

# Gmail App Password (required for verification, reset, and contact emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password_here

# Created automatically on first server start if both values are set
ADMIN_NAME=Baafiye Admin
ADMIN_EMAIL=admin@baafiye.org
ADMIN_PASSWORD=ChangeThisAdminPassword
ADMIN_PHONE=+252610000000
