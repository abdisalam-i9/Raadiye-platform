PORT=5000
MONGO_URI=mongodb://localhost:27017/baafiye
JWT_SECRET=replace_with_a_long_random_secret

# Public URL of the React client (used in password-reset emails)
CLIENT_URL=http://localhost:3000

# Optional Gmail App Password. Used only for password-reset emails.
# If empty, the reset link is printed in the server console.
EMAIL_USER=
EMAIL_PASS=
# Optional custom SMTP. If omitted, Gmail is used when EMAIL_USER/PASS are set.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587

# Created automatically on first server start if both values are set
ADMIN_NAME=Raadiye Admin
ADMIN_EMAIL=admin@baafiye.org
ADMIN_PASSWORD=ChangeThisAdminPassword
ADMIN_PHONE=+252610000000

# Optional. If set, photo upload can suggest a title and category.
OPENAI_API_KEY=

# Optional. If all three are set, item photos go to Cloudinary.
# Otherwise they are stored locally in server/uploads/items.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
